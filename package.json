    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "expo-web-browser": "~13.0.3",
    "firebase": "^10.14.1",
    "i18next": "^26.4.2",
    "nativewind": "^4.1.23",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.2",
