# ---------------------------------------------------------------------------
# Expo public env vars — bundled into the app at build time. Values here
# are placeholders; copy to `.env` and fill in real credentials.
# ---------------------------------------------------------------------------

# -- Firebase ---------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Set to 'true' to redirect Auth + Firestore to the local emulator suite
# (requires `npm run emulators` running on the standard ports).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false

# -- Google OAuth (expo-auth-session) --------------------------------------
# Create credentials at console.cloud.google.com → Credentials → OAuth client.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# -- Stripe ----------------------------------------------------------------
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# -- Locale / store identity -----------------------------------------------
EXPO_PUBLIC_DEFAULT_COUNTRY=IL
# WhatsApp number of the store (E.164 without the leading +) — used as the
# "Contact store" fallback link on the order confirmation screen.
EXPO_PUBLIC_STORE_WHATSAPP=
