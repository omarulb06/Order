# ---------------------------------------------------------------------------
# Local test / emulator env. Copy to `.env.test` and leave the values as-is
# for the standard local Firebase emulator setup.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_DEFAULT_COUNTRY=IL

# Point the Firebase client at the local emulator.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
EXPO_PUBLIC_FIREBASE_API_KEY=fake-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=order-app-local.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=order-app-local
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=order-app-local.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
EXPO_PUBLIC_FIREBASE_APP_ID=1:0:web:0

# Admin SDK — only read when running the seed script against the emulator.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GCLOUD_PROJECT=order-app-local

# Set to 1 to actually run the integration tests (otherwise they skip).
# FIREBASE_EMULATOR_RUNNING=1
